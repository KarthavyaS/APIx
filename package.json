{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",

  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx server.ts",

    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",

    "start": "node dist/server.cjs",

    "clean": "rm -rf dist server.js",

    "lint": "tsc --noEmit"
  },

  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "concurrently": "^10.0.5"
  },

  "devDependencies": {},

  "description": "An automated national aviation intelligence platform that ethically collects airfare data from major Indian airlines and OTAs, cleans and standardizes the quotes, computes a weighted Airfare Price Index (APIx), detects price anomalies, forecasts fares, benchmarks against official DGCA data, and exposes insights via an interactive dashboard and REST API.",

  "main": "index.js",

  "directories": {
    "doc": "docs"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthavyaS/APIx.git"
  },

  "keywords": [],

  "author": "",
  "license": "ISC",

  "bugs": {
    "url": "https://github.com/KarthavyaS/APIx/issues"
  },

  "homepage": "https://github.com/KarthavyaS/APIx#readme"
}