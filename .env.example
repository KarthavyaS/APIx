# ==============================================================================
# Airfare Price Index (APIx) - Environment Variables Configuration
# ==============================================================================

# 1. SerpApi Google Flights API Key (Primary Tier 1 Live Data Source)
# Get your free key (250 searches/month) at: https://serpapi.com/
SERPAPI_KEY="your_serpapi_key_here"

# 2. RapidAPI Key (Backup Tier 1 Data Source - DataCrawler Google Flights)
# Get your key at: https://rapidapi.com/
RAPIDAPI_KEY="your_rapidapi_key_here"

# 3. Database Connection URL (Optional)
# Defaults to local SQLite (sqlite:///backend/apix_airfare.db) if omitted.
# Example PostgreSQL / Neon URL: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="sqlite:///backend/apix_airfare.db"

# 4. Google Gemini AI API Key (Optional - for AI Studio insights & analysis)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 5. Application Hosting URL (Optional - injected by deployment platforms)
APP_URL="http://localhost:3000"

